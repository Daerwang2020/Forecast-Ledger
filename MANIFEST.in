include LICENSE
include README.md
include CITATION.cff
recursive-include ts_repro/catalog *.yaml
recursive-include docs *.md
recursive-include docs/assets *.svg
recursive-include examples *.py
recursive-include examples *.md
recursive-include deploy/huggingface-space *
recursive-include scripts *.py
recursive-include viewer *.html
global-exclude ._*
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.safetensors
global-exclude *.ckpt
global-exclude *.pth
global-exclude *.pt
global-exclude *.bin
prune build
prune *.egg-info
